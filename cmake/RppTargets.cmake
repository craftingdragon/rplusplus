include_guard(GLOBAL)
function(_rpp_search t seen result)
  if(t IN_LIST seen)
    message(FATAL_ERROR "Rust dependency cycle at ${t}")
  endif()
  list(APPEND seen "${t}")
  set(paths)
  get_target_property(links "${t}" LINK_LIBRARIES)
  foreach(link IN LISTS links)
    if(TARGET "${link}")
      list(APPEND paths "-Ldependency=$<TARGET_FILE_DIR:${link}>")
      _rpp_search("${link}" "${seen}" nested)
      list(APPEND paths ${nested})
    endif()
  endforeach()
  list(REMOVE_DUPLICATES paths)
  set(${result} "${paths}" PARENT_SCOPE)
endfunction()
function(_rpp_targets dir)
  get_property(targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(t IN LISTS targets)
    get_target_property(sources "${t}" SOURCES)
    set(roots)
    foreach(s IN LISTS sources)
      if(s MATCHES "\\.rs$")
        list(APPEND roots "${s}")
      endif()
    endforeach()
    get_target_property(root "${t}" RPP_CRATE_ROOT)
    if(NOT roots AND NOT root)
      continue()
    endif()
    if(NOT root)
      list(LENGTH roots n)
      if(NOT n EQUAL 1)
        message(FATAL_ERROR "${t}: specify RPP_CRATE_ROOT for multiple Rust sources")
      endif()
      list(GET roots 0 root)
    endif()
    get_target_property(srcdir "${t}" SOURCE_DIR)
    get_filename_component(root "${root}" ABSOLUTE BASE_DIR "${srcdir}")
    get_property(owner SOURCE "${root}" DIRECTORY "${dir}" PROPERTY _RPP_OWNER)
    if(owner AND NOT owner STREQUAL t)
      message(FATAL_ERROR "Rust root reused by ${owner} and ${t}")
    endif()
    set_property(SOURCE "${root}" DIRECTORY "${dir}" PROPERTY _RPP_OWNER "${t}")
    set(root_listed FALSE)
    foreach(s IN LISTS roots)
      get_filename_component(abs "${s}" ABSOLUTE BASE_DIR "${srcdir}")
      if(abs STREQUAL root)
        set(root_listed TRUE)
      endif()
      if(NOT abs STREQUAL root)
        set_source_files_properties("${s}" DIRECTORY "${dir}" PROPERTIES HEADER_FILE_ONLY TRUE)
      endif()
    endforeach()
    if(NOT root_listed)
      target_sources("${t}" PRIVATE "${root}")
    endif()
    get_target_property(target_type "${t}" TYPE)
    if(NOT target_type MATCHES "^(STATIC_LIBRARY|EXECUTABLE)$")
      message(FATAL_ERROR "${t}: unsupported Rust CMake target type ${target_type}")
    endif()
    foreach(prop IN ITEMS NAME TYPE EDITION ENTRY_LANGUAGE)
      get_target_property(v_${prop} "${t}" RPP_CRATE_${prop})
    endforeach()
    get_target_property(entry "${t}" RPP_ENTRY_LANGUAGE)
    if(NOT entry)
      set(entry Rpp)
    endif()
    if(NOT v_NAME)
      string(REPLACE "-" "_" v_NAME "${t}")
    endif()
    if(NOT v_EDITION)
      get_target_property(v_EDITION "${t}" RPP_EDITION)
      if(NOT v_EDITION)
        set(v_EDITION 2024)
      endif()
    endif()
    if(NOT v_TYPE)
      get_target_property(type "${t}" TYPE)
      if(type STREQUAL EXECUTABLE)
        set(v_TYPE bin)
      else()
        set(v_TYPE staticlib)
      endif()
    endif()
    if(NOT v_TYPE MATCHES "^(bin|rlib|staticlib)$")
      message(FATAL_ERROR "Unsupported Rust crate type: ${v_TYPE}")
    endif()
    if(NOT v_NAME MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
      message(FATAL_ERROR "${t}: invalid Rust crate name ${v_NAME}")
    endif()
    if(NOT entry MATCHES "^(Rpp|CXX)$")
      message(FATAL_ERROR "${t}: invalid RPP_ENTRY_LANGUAGE")
    endif()
    if(NOT EXISTS "${root}")
      message(FATAL_ERROR "${t}: Rust root does not exist: ${root}")
    endif()
    # Make consolidates compiler depfiles on a later dependency pass. Register
    # the depfile as a co-output so loss before consolidation invalidates the
    # Rust object via CMAKE_MULTIPLE_OUTPUT_PAIRS. Ninja manages its own depfiles.
    if(CMAKE_GENERATOR STREQUAL "Unix Makefiles")
      set_property(SOURCE "${root}" DIRECTORY "${dir}" APPEND PROPERTY OBJECT_OUTPUTS
        "$<FILTER:$<TARGET_OBJECTS:${t}>,INCLUDE,[.]rlib$>.d")
    endif()
    set_property(SOURCE "${root}" DIRECTORY "${dir}" APPEND PROPERTY OBJECT_DEPENDS
      "${CMAKE_Rpp_COMPILER}" "${RPP_RUSTC_EXECUTABLE}")
    set_property(TARGET "${t}" PROPERTY RPP_CRATE_NAME "${v_NAME}")
    set_property(TARGET "${t}" PROPERTY RPP_CRATE_TYPE "${v_TYPE}")
    set_property(TARGET "${t}" PROPERTY LINKER_LANGUAGE Rpp)
    if(v_TYPE STREQUAL rlib)
      set_target_properties("${t}" PROPERTIES PREFIX lib SUFFIX .rlib)
      get_target_property(output_name "${t}" OUTPUT_NAME)
      if(NOT output_name)
        set_property(TARGET "${t}" PROPERTY OUTPUT_NAME "${v_NAME}")
      endif()
    endif()
    set_property(SOURCE "${root}" DIRECTORY "${dir}" APPEND PROPERTY COMPILE_OPTIONS
      --name "${v_NAME}" --kind "${v_TYPE}" --entry "${entry}" --edition "${v_EDITION}")
    _rpp_search("${t}" "" search)
    set_property(SOURCE "${root}" DIRECTORY "${dir}" APPEND PROPERTY COMPILE_OPTIONS ${search})
    set(names)
    get_target_property(deps "${t}" LINK_LIBRARIES)
    foreach(dep IN LISTS deps)
      if(TARGET "${dep}")
        get_target_property(dep_kind "${dep}" RPP_CRATE_TYPE)
        if(dep_kind STREQUAL rlib)
          if(v_TYPE STREQUAL staticlib)
            get_target_property(iface "${t}" INTERFACE_LINK_LIBRARIES)
            list(REMOVE_ITEM iface "${dep}" "$<LINK_ONLY:${dep}>")
            set_property(TARGET "${t}" PROPERTY INTERFACE_LINK_LIBRARIES "${iface}")
          endif()
          get_target_property(dep_name "${dep}" RPP_CRATE_NAME)
          if(NOT dep_name)
            string(REPLACE "-" "_" dep_name "${dep}")
          endif()
          if(dep_name IN_LIST names)
            message(FATAL_ERROR "Duplicate direct Rust crate name: ${dep_name}")
          endif()
          list(APPEND names "${dep_name}")
          set_property(SOURCE "${root}" DIRECTORY "${dir}" APPEND PROPERTY COMPILE_OPTIONS
            "--extern=${dep_name}=$<TARGET_FILE:${dep}>" "-Ldependency=$<TARGET_FILE_DIR:${dep}>")
          add_custom_target("_rpp_${t}_${dep}" DEPENDS "$<TARGET_FILE:${dep}>")
          add_dependencies("_rpp_${t}_${dep}" "${dep}")
          add_dependencies("${t}" "_rpp_${t}_${dep}")
        endif()
      endif()
    endforeach()
  endforeach()
  get_property(children DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    _rpp_targets("${child}")
  endforeach()
endfunction()
get_property(_in_try GLOBAL PROPERTY IN_TRY_COMPILE)
if(NOT _in_try)
  cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _rpp_targets "${CMAKE_SOURCE_DIR}")
endif()
