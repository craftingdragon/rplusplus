get_filename_component(_rpp_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
find_program(CMAKE_Rpp_COMPILER NAMES rpp HINTS "${_rpp_prefix}/bin" REQUIRED)
find_program(RPP_RUSTC_EXECUTABLE NAMES rustc REQUIRED)
execute_process(COMMAND "${RPP_RUSTC_EXECUTABLE}" --version OUTPUT_VARIABLE compiler_version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Rpp compiler=${CMAKE_Rpp_COMPILER}: ${compiler_version}")
string(REGEX MATCH "rustc ([0-9]+\\.[0-9]+\\.[0-9]+)" _match "${compiler_version}")
if(NOT _match)
  message(FATAL_ERROR "Cannot identify rustc: ${compiler_version}")
endif()
set(CMAKE_Rpp_COMPILER_VERSION "${CMAKE_MATCH_1}")
if(CMAKE_Rpp_COMPILER_VERSION VERSION_LESS 1.85)
  message(FATAL_ERROR "Rpp requires rustc 1.85 or later for edition 2024")
endif()
set(CMAKE_Rpp_COMPILER_ID Rust)
find_program(CMAKE_AR NAMES llvm-ar ar REQUIRED)
find_program(CMAKE_RANLIB NAMES llvm-ranlib ranlib REQUIRED)
set(CMAKE_Rpp_COMPILER_ENV_VAR RPP)
configure_file("${CMAKE_CURRENT_LIST_DIR}/CMakeRppCompiler.cmake.in" "${CMAKE_PLATFORM_INFO_DIR}/CMakeRppCompiler.cmake" @ONLY)
