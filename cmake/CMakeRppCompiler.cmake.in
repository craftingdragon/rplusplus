set(CMAKE_Rpp_COMPILER "@CMAKE_Rpp_COMPILER@")
set(CMAKE_Rpp_COMPILER_ID Rust)
set(CMAKE_Rpp_COMPILER_LOADED 1)
set(CMAKE_Rpp_SOURCE_FILE_EXTENSIONS rs)
set(CMAKE_Rpp_OUTPUT_EXTENSION .o)
set(CMAKE_Rpp_COMPILER_ENV_VAR RPP)

set(CMAKE_AR "@CMAKE_AR@")
set(CMAKE_RANLIB "@CMAKE_RANLIB@")

set(CMAKE_Rpp_COMPILER_VERSION "@CMAKE_Rpp_COMPILER_VERSION@")
