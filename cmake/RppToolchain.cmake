include_guard(GLOBAL)
function(rpp_validate_toolchain)
  if(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Rpp supports native toolchains only; use a native build directory")
  endif()
  execute_process(COMMAND "${RPP_RUSTC_EXECUTABLE}" -vV
    RESULT_VARIABLE status OUTPUT_VARIABLE identity ERROR_VARIABLE diagnostic)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot run selected rustc '${RPP_RUSTC_EXECUTABLE}': ${diagnostic}. Set RPP_RUSTC_EXECUTABLE to an installed stable compiler.")
  endif()
  string(REGEX MATCH "release: ([0-9]+\\.[0-9]+\\.[0-9]+)" match "${identity}")
  if(NOT match OR CMAKE_MATCH_1 VERSION_LESS 1.85)
    message(FATAL_ERROR "Rpp requires stable Rust >=1.85 for edition 2024. Select it with -DRPP_RUSTC_EXECUTABLE=/path/to/rustc. Found: ${identity}")
  endif()
  if(identity MATCHES "nightly|beta")
    message(WARNING "Selected Rust is outside the supported stable matrix: ${identity}")
  endif()
  execute_process(COMMAND "${RPP_RUSTC_EXECUTABLE}" --print sysroot
    RESULT_VARIABLE status OUTPUT_VARIABLE sysroot OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT status EQUAL 0 OR NOT IS_DIRECTORY "${sysroot}/lib/rustlib")
    message(FATAL_ERROR "Selected rustc has no usable standard library sysroot: ${sysroot}")
  endif()
  if(EXISTS "${sysroot}/bin/rustc${CMAKE_EXECUTABLE_SUFFIX}")
    execute_process(COMMAND "${sysroot}/bin/rustc${CMAKE_EXECUTABLE_SUFFIX}" -vV
      OUTPUT_VARIABLE pinned RESULT_VARIABLE pinned_status)
    if(pinned_status EQUAL 0 AND pinned STREQUAL identity)
      set(RPP_RUSTC_EXECUTABLE "${sysroot}/bin/rustc${CMAKE_EXECUTABLE_SUFFIX}" CACHE FILEPATH "Selected Rust compiler" FORCE)
    endif()
  endif()
  set(fingerprint "${identity}\nsysroot: ${sysroot}")
  string(SHA256 fingerprint "${fingerprint}")
  # Cache hashes rather than multiline compiler output.
  if(DEFINED RPP_TOOLCHAIN_HASH AND NOT RPP_TOOLCHAIN_HASH STREQUAL fingerprint)
    message(FATAL_ERROR "Rust toolchain changed; configure a fresh build directory to rebuild all crates consistently.")
  endif()
  set(RPP_TOOLCHAIN_HASH "${fingerprint}" CACHE INTERNAL "Selected Rust toolchain identity")
endfunction()
