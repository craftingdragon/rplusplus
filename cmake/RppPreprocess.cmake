function(_rpp_preprocess_paths target source_dir source_root entries result)
  set(paths)
  foreach(path IN LISTS entries)
    if(path MATCHES "\\$<")
      message(FATAL_ERROR "${target}: preprocessing file declarations must be configuration-independent: ${path}")
    endif()
    get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${source_dir}")
    cmake_path(IS_PREFIX source_root "${path}" NORMALIZE inside)
    file(RELATIVE_PATH relative "${source_root}" "${path}")
    if(NOT inside OR relative STREQUAL "" OR relative MATCHES "^[.]rpp(/|$)")
      message(FATAL_ERROR "${target}: invalid preprocessing input under ${source_root}: ${path}")
    endif()
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
      message(FATAL_ERROR "${target}: preprocessing input must exist as a file: ${path}")
    endif()
    list(APPEND paths "${path}")
  endforeach()
  set(${result} "${paths}" PARENT_SCOPE)
endfunction()

function(_rpp_preprocess_target target dir root sources edition)
  get_target_property(binary "${target}" BINARY_DIR)
  foreach(prop IN ITEMS ROOT INPUTS DATA)
    get_property(pp_${prop} TARGET "${target}" PROPERTY RPP_PREPROCESS_${prop})
  endforeach()
  if(NOT pp_ROOT)
    set(pp_ROOT "${dir}")
  endif()
  if(pp_ROOT MATCHES "\\$<")
    message(FATAL_ERROR "${target}: RPP_PREPROCESS_ROOT must be configuration-independent")
  endif()
  if(NOT edition MATCHES "^(2021|2024)$")
    message(FATAL_ERROR "${target}: preprocessing requires Rust edition 2021 or 2024")
  endif()
  get_filename_component(source_root "${pp_ROOT}" ABSOLUTE BASE_DIR "${dir}")
  _rpp_preprocess_paths("${target}" "${dir}" "${source_root}" "${root};${sources}" units)
  list(REMOVE_DUPLICATES units)
  _rpp_preprocess_paths("${target}" "${dir}" "${source_root}" "${pp_INPUTS}" fragments)
  _rpp_preprocess_paths("${target}" "${dir}" "${source_root}" "${pp_DATA}" assets)
  set(inputs ${units} ${fragments} ${assets})
  set(unique ${inputs})
  list(REMOVE_DUPLICATES unique)
  if(NOT "${unique}" STREQUAL "${inputs}")
    message(FATAL_ERROR "${target}: duplicate preprocessing declarations or conflicting input roles")
  endif()

  set(base "${binary}/.rpp-preprocess/${target}")
  set(state "${base}/cfg-$<CONFIG>")
  set(tree "${state}/tree")
  set(depfile "${tree}/.rpp/preprocess.d")
  set(spec "${state}/options")
  set(payload ".rpp/manifest" ".rpp/source-map.json")
  set(args)
  foreach(path IN LISTS units assets)
    file(RELATIVE_PATH relative "${source_root}" "${path}")
    list(APPEND payload "${relative}")
    if(path IN_LIST assets)
      list(APPEND args --data "${path}")
    elseif(NOT path STREQUAL root)
      list(APPEND args --source "${path}")
    endif()
  endforeach()
  foreach(path IN LISTS fragments)
    list(APPEND args --input "${path}")
  endforeach()

  set(defs "$<TARGET_GENEX_EVAL:${target},$<TARGET_PROPERTY:${target},RPP_PREPROCESS_DEFINITIONS>>")
  set(dirs "$<TARGET_GENEX_EVAL:${target},$<TARGET_PROPERTY:${target},RPP_PREPROCESS_INCLUDE_DIRECTORIES>>")
  set(defargs "$<JOIN:${defs},$<SEMICOLON>-D>")
  set(dirargs "$<JOIN:${dirs},$<SEMICOLON>-I>")
  # The record invalidates Make's rule when its evaluated arguments change.
  # The command receives the actual values through VERBATIM argv.
  string(JOIN "\n" fixed "${root}" "${source_root}" "${dir}" "${edition}" ${args})
  file(GENERATE OUTPUT "${spec}" CONTENT
    "rpp-cmake-preprocess-v1\n${fixed}\ninclude-directories\n$<JOIN:${dirs},\n>\ndefinitions\n$<JOIN:${defs},\n>\n" TARGET "${target}")
  set(outputs "${tree}/.rpp/complete" "${tree}/.rpp/owned")
  foreach(path IN LISTS payload)
    list(APPEND outputs "${tree}/${path}")
  endforeach()
  set(finish)
  if(CMAKE_GENERATOR STREQUAL "Unix Makefiles")
    list(APPEND outputs "${depfile}")
    # Make models secondary outputs as depending on the primary output.
    # Finish their timestamp update now, before a native object can compile
    # against a snapshot whose secondary-output recipes are still due.
    list(SUBLIST outputs 1 -1 secondary)
    set(finish COMMAND "${CMAKE_COMMAND}" -E touch_nocreate ${secondary})
  endif()
  set(dep_rule DEPFILE "${depfile}")
  if(CMAKE_GENERATOR STREQUAL "Ninja Multi-Config" AND CMAKE_CROSS_CONFIGS
      AND CMAKE_VERSION VERSION_LESS 4.5)
    # CMake 3.25 crashes while generating cross-config custom commands
    # with DEPFILE. All original inputs are already explicit prerequisites.
    set(dep_rule)
  endif()
  if(CMAKE_GENERATOR MATCHES "^Ninja" AND CMAKE_VERSION VERSION_LESS 4.5
      AND CMAKE_BINARY_DIR MATCHES "[$]")
    # Older CMake emits a literal dollar in Ninja's transformed depfile path.
    # The explicit prerequisites already cover every declared input.
    set(dep_rule)
  endif()
  add_custom_command(OUTPUT ${outputs}
    COMMAND "${CMAKE_Rpp_COMPILER}" preprocess "${root}"
      --rpp-cmake-source-dir "${dir}" --source-root "${source_root}"
      --output-dir "${tree}" --edition "${edition}" --depfile "${depfile}" ${args}
      "$<$<NOT:$<STREQUAL:${dirargs},>>:-I${dirargs}>"
      "$<$<NOT:$<STREQUAL:${defargs},>>:-D${defargs}>"
    ${finish}
    WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
    DEPENDS "${CMAKE_Rpp_COMPILER}" "${spec}" ${inputs}
    ${dep_rule} VERBATIM COMMAND_EXPAND_LISTS)
  string(SHA256 helper "${binary}/${target}")
  add_custom_target("_rpp_preprocess_${helper}" DEPENDS ${outputs})
  add_dependencies("${target}" "_rpp_preprocess_${helper}")
  set_property(TARGET "${target}" APPEND PROPERTY ADDITIONAL_CLEAN_FILES
    "${tree}" "${state}/tree.rpp-owned")

  file(RELATIVE_PATH entry "${source_root}" "${root}")
  set_source_files_properties("${root}" DIRECTORY "${dir}" PROPERTIES HEADER_FILE_ONLY TRUE)
  target_sources("${target}" PRIVATE "${tree}/${entry}")
  if(CMAKE_CONFIGURATION_TYPES)
    set(configs)
    foreach(config IN LISTS CMAKE_CONFIGURATION_TYPES)
      list(APPEND configs "cfg-${config}")
    endforeach()
  else()
    set(configs "cfg-${CMAKE_BUILD_TYPE}")
  endif()
  foreach(config IN LISTS configs)
    set(concrete "${base}/${config}/tree")
    set(generated "${concrete}/${entry}")
    set_source_files_properties("${generated}" DIRECTORY "${dir}" PROPERTIES GENERATED TRUE LANGUAGE Rpp)
    foreach(prop IN ITEMS COMPILE_OPTIONS COMPILE_FLAGS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES OBJECT_DEPENDS)
      get_property(value SOURCE "${root}" DIRECTORY "${dir}" PROPERTY "${prop}")
      if(NOT "${value}" STREQUAL "")
        set_property(SOURCE "${generated}" DIRECTORY "${dir}" PROPERTY "${prop}" "${value}")
      endif()
    endforeach()
    set_property(SOURCE "${generated}" DIRECTORY "${dir}" APPEND PROPERTY COMPILE_OPTIONS
      --rpp-snapshot "${concrete}" --rpp-original-entry "${root}")
    foreach(path IN LISTS payload)
      set_property(SOURCE "${generated}" DIRECTORY "${dir}" APPEND PROPERTY OBJECT_DEPENDS "${concrete}/${path}")
    endforeach()
    if(CMAKE_GENERATOR STREQUAL "Unix Makefiles")
      set_property(SOURCE "${generated}" DIRECTORY "${dir}" APPEND PROPERTY OBJECT_OUTPUTS
        "$<FILTER:$<TARGET_OBJECTS:${target}>,INCLUDE,[.]rlib$>.d")
    endif()
  endforeach()
endfunction()
