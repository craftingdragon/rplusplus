set(CMAKE_Rpp_COMPILE_OBJECT "<CMAKE_Rpp_COMPILER> compile --rustc \"${RPP_RUSTC_EXECUTABLE}\" --depfile <DEP_FILE> <FLAGS> -o <OBJECT> <SOURCE>")
set(CMAKE_Rpp_DEPFILE_FORMAT gcc)
set(CMAKE_Rpp_DEPENDS_USE_COMPILER TRUE)
set(CMAKE_Rpp_LINKER_PREFERENCE 40)
set(CMAKE_Rpp_LINKER_PREFERENCE_PROPAGATES 1)
set(_rpp_link "<CMAKE_Rpp_COMPILER> link --rustc \"${RPP_RUSTC_EXECUTABLE}\" --cxx \"${CMAKE_CXX_COMPILER}\" --ar \"${CMAKE_AR}\" -o <TARGET> <OBJECTS> --libraries <LINK_FLAGS> <LINK_LIBRARIES>")
set(CMAKE_Rpp_CREATE_STATIC_LIBRARY "${_rpp_link} --rpp-archive")
set(CMAKE_Rpp_LINK_EXECUTABLE "${_rpp_link}")
set(CMAKE_Rpp_FLAGS_DEBUG_INIT "-Copt-level=0 -Cdebuginfo=2")
set(CMAKE_Rpp_FLAGS_RELEASE_INIT "-Copt-level=3 -Cdebug-assertions=no")
include(CMakeInitializeConfigs)
cmake_initialize_per_config_variable(CMAKE_Rpp_FLAGS "Rust compiler flags")
set(CMAKE_Rpp_INFORMATION_LOADED 1)
include("${CMAKE_CURRENT_LIST_DIR}/RppTargets.cmake")
