# SPDX-License-Identifier: GPL-3.0-or-later
# Maintainer: craftingDragon7
pkgname=rplusplus
pkgver=@VERSION@
pkgrel=1
pkgdesc='Experimental Cargo-free Rust compiler driver and native CMake integration'
arch=('x86_64')
url='https://github.com/craftingdragon/rplusplus'
license=('GPL-3.0-or-later')
# rustup provides unversioned rust. CMake checks the selected rustc version.
depends=('rust' 'cmake>=3.25' 'gcc-libs')
makedepends=('ninja' 'python')
# Mixed Rust/C++ links need regular C++ objects, not GCC LTO bytecode.
options=('!lto')
source=("rplusplus-${pkgver}.tar.gz")
sha256sums=('@SOURCE_SHA256@')
build() {
  cmake -S "rplusplus-${pkgver}" -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr -DRPP_RUSTC_EXECUTABLE="${RPP_RUSTC_EXECUTABLE:-/usr/bin/rustc}"
  cmake --build build
}
check() {
  RPP_TEST_RUSTC="${RPP_RUSTC_EXECUTABLE:-/usr/bin/rustc}" ctest --test-dir build --output-on-failure
}
package() {
  DESTDIR="$pkgdir" cmake --install build
}
